PORT=3000
MC_HOST_DATA_DIR=.data
MC_HOST_IMAGE=itzg/minecraft-server:java25
MC_HOST_API_TOKEN=replace-with-a-long-random-token
MC_HOST_HOST_DATA_DIR=/var/lib/open-mc-host
MC_HOST_PANEL_PORT=3000
MC_HOST_PUBLIC_HOST=
MC_HOST_DASHBOARD_URL=
MC_HOST_LAN_IP=
MC_HOST_NETWORK_MODE=auto
MC_HOST_PORT_RANGE=25565-25575
MC_HOST_MAX_UPLOAD_MB=250
MC_HOST_AUTO_BACKUP_ENABLED=true
MC_HOST_AUTO_BACKUP_HOUR=3
